{
  "name": "@borjablm/consent-kit",
  "version": "1.1.1",
  "description": "Accept/Reject cookie banner with Google Consent Mode v2, scripts held until consent and a consent log. Core script, React helpers and a WordPress plugin.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Borjablm/consent-kit.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./adapters/index.d.ts",
      "default": "./adapters/index.mjs"
    },
    "./script": {
      "types": "./adapters/script.d.ts",
      "default": "./adapters/script.mjs"
    },
    "./react": {
      "types": "./adapters/react.d.ts",
      "default": "./adapters/react.mjs"
    },
    "./consent-kit.js": "./consent-kit.js",
    "./schema.json": "./schema/config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "consent-kit.js",
    "adapters",
    "schema",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
